# 复制为 backend/.env 后按需修改

# 本地开发推荐：SQLite，零额外服务
DATABASE_URL=sqlite:///./petct_research.db

# PostgreSQL：先执行 pip install -r requirements-postgres.txt，再启用下面一行（使用 psycopg 3，勿写 psycopg2）
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/petct_research

OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
RESEARCH_LLM_MODEL=gpt-4o

# 智能对话 DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# 院方演示：设为 true 时科研接口永远不调用大模型，只返回内置模拟报告
DEMO_MODE=false

PETCT_MODEL_PATH=models/petct_seg_model.pth

# 公网部署时填写你的站点来源（逗号分隔），与浏览器地址栏协议+域名一致，例如：
# CORS_ORIGINS=https://petct.example.com,https://www.petct.example.com

# DICOM 影像诊断分析接口（POST multipart: files, returnBase64）
PATHOLOGY_IMAGING_API_URL=http://42.81.102.195:8000/ct-module/dicom/upload
# 影像诊断分析约需 5 分钟，读取超时建议 ≥420 秒（7 分钟）
PATHOLOGY_IMAGING_API_TIMEOUT=420

# PCI 评分（分割完成后调用 genpci，需服务端 DICOM 目录路径）
PCI_API_URL=http://42.81.102.195:8509/genpci
PCI_API_TIMEOUT=300
PCI_ENABLED=true
# 默认 true：分割完成后按 sessionId / ZIP 文件名猜测 dcm_path 并轮询 genpci
PCI_PATH_GUESS=true
# 分割完成后轮询 genpci（等待 DICOM 落盘），间隔秒数 × 最大次数 ≈ 最长等待时间
PCI_POLL_INTERVAL_SECONDS=10
PCI_POLL_MAX_ATTEMPTS=18
# CT 模块未返回 dcm_path 时，用 sessionId 拼路径（需与 CT 落盘规则一致）
PCI_DCM_PATH_TEMPLATE=/mc/opt/PMPPredict/temp_data/dcm_uploads/{session_id}
